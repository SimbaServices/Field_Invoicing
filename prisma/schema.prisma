// Field Invoicing — multi-tenant digital ticketing & receivables platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  customers        Customer[]
  bankingAccounts  BankingAccount[]
  integrations     IntegrationConfig[]
  stripeConnect    StripeConnectAccount?
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  name           String
  role           String   @default("member") // owner | admin | member
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  legalName      String?
  email          String?
  phone          String?
  billingAddress String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentTerms   PaymentTerms?
  emailConfigs   CustomerEmailConfig[]
  termSheets     TermSheet[]
  quotes         Quote[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]

  @@index([organizationId])
}

/// Configurable senders and recipients for quotes, signing notices, and payment links
model CustomerEmailConfig {
  id         String   @id @default(cuid())
  customerId String
  purpose    String // quote | payment | signing | general
  role       String // sender | recipient
  email      String
  name       String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, purpose])
}

model PaymentTerms {
  id               String   @id @default(cuid())
  customerId       String   @unique
  name             String   @default("Net 30")
  netDays          Int      @default(30)
  earlyPayDiscount Float? // percent
  lateFeePercent   Float?
  currency         String   @default("usd")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

/// Assisted / automated term sheet drafts tied to a customer
model TermSheet {
  id           String   @id @default(cuid())
  customerId   String
  title        String
  status       String   @default("draft") // draft | review | accepted | archived
  contentJson  String // structured sections as JSON
  contentMarkdown String?
  assistedBy   String? // ai | template | manual
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Quote {
  id            String   @id @default(cuid())
  customerId    String
  number        String
  title         String
  status        String   @default("draft") // draft | sent | accepted | declined | expired
  lineItemsJson String
  subtotalCents Int
  taxCents      Int      @default(0)
  totalCents    Int
  currency      String   @default("usd")
  validUntil    DateTime?
  sentAt        DateTime?
  sentToJson    String? // recipients snapshot
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, number])
  @@index([customerId])
}

/// Job PO (parent) or optional Sub-PO (child). Sub-POs inherit customer scope and carry parentPoId.
model PurchaseOrder {
  id           String   @id @default(cuid())
  customerId   String
  parentPoId   String? // set for sub-POs
  number       String
  title        String
  description  String?
  status       String   @default("open") // open | in_progress | closed | cancelled
  budgetCents  Int?
  currency     String   @default("usd")
  /// Characteristic inherited / stamped from parent when this is a sub-PO
  parentNumber String?
  jobCode      String? // shared job identifier across parent + subs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  closedAt     DateTime?

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  parent   PurchaseOrder?  @relation("PoHierarchy", fields: [parentPoId], references: [id])
  children PurchaseOrder[] @relation("PoHierarchy")
  invoices Invoice[]

  @@unique([customerId, number])
  @@index([customerId])
  @@index([parentPoId])
  @@index([jobCode])
}

/// Invoices generated in-app or digitized from hard-copy upload — same storage model once ingested
model Invoice {
  id             String   @id @default(cuid())
  customerId     String
  purchaseOrderId String?
  number         String
  title          String
  description    String?
  /// pending | signed | paid
  status         String   @default("pending")
  /// generated | uploaded
  source         String   @default("generated")
  amountCents    Int
  currency       String   @default("usd")
  lineItemsJson  String   @default("[]")
  /// Phase set at upload (or create): pending | signed | paid
  lifecyclePhase String   @default("pending")
  signedAt       DateTime?
  signedByName   String?
  signedByEmail  String?
  signatureData  String? // base64 stroke or typed signature
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  blob          InvoiceBlob?
  receivable    Receivable?
  accessTokens  AccessToken[]
  payments      Payment[]

  @@unique([customerId, number])
  @@index([customerId])
  @@index([purchaseOrderId])
  @@index([status])
}

/// Blob metadata — file lives under org/customer path in object storage
model InvoiceBlob {
  id           String   @id @default(cuid())
  invoiceId    String   @unique
  storageKey   String // e.g. orgs/{orgId}/customers/{customerId}/invoices/{invoiceId}/{filename}
  filename     String
  contentType  String
  sizeBytes    Int
  checksum     String?
  digitizedText String? // OCR / extracted text when uploaded
  createdAt    DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

/// Confirmed receivable created when an invoice is signed; countdown uses customer payment terms
model Receivable {
  id            String   @id @default(cuid())
  invoiceId     String   @unique
  amountCents   Int
  currency      String   @default("usd")
  confirmedAt   DateTime @default(now())
  dueAt         DateTime
  netDays       Int
  status        String   @default("open") // open | paid | overdue | written_off
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([dueAt])
  @@index([status])
}

/// Limited-access links for signing or paying without an account
model AccessToken {
  id        String   @id @default(cuid())
  invoiceId String
  token     String   @unique
  purpose   String // sign | pay
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, purpose])
}

model Payment {
  id                    String   @id @default(cuid())
  invoiceId             String
  amountCents           Int
  currency              String   @default("usd")
  status                String   @default("pending") // pending | succeeded | failed | refunded
  provider              String   @default("stripe") // stripe | quickbooks | manual | other
  stripeCheckoutSessionId String?
  stripePaymentIntentId String?
  providerRef           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Org banking / payout destinations — versatile for multiple providers
model BankingAccount {
  id                   String   @id @default(cuid())
  organizationId       String
  label                String
  provider             String // stripe_connect | plaid | manual | ach
  isDefault            Boolean  @default(false)
  accountLast4         String?
  routingLast4         String?
  currency             String   @default("usd")
  stripeExternalAccountId String?
  metadataJson         String   @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// Stripe Connect linked account for the organization (Accounts v2 / destination charges)
model StripeConnectAccount {
  id                 String   @id @default(cuid())
  organizationId     String   @unique
  stripeAccountId    String   @unique
  dashboard          String   @default("express")
  feesCollector      String   @default("application")
  lossesCollector    String   @default("application")
  chargePattern      String   @default("destination")
  onboardingComplete Boolean  @default(false)
  transfersActive    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// QuickBooks and other accounting / payment service credentials (encrypted at rest in production)
model IntegrationConfig {
  id             String   @id @default(cuid())
  organizationId String
  provider       String // quickbooks | xero | paypal | square | other
  status         String   @default("disconnected") // disconnected | connected | error
  externalRealmId String?
  accessTokenEnc String?
  refreshTokenEnc String?
  metadataJson   String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model OutboundEmail {
  id         String   @id @default(cuid())
  customerId String?
  toJson     String
  fromEmail  String
  subject    String
  bodyText   String
  purpose    String // quote | sign_link | payment_link | general
  status     String   @default("queued") // queued | sent | failed
  relatedType String?
  relatedId  String?
  sentAt     DateTime?
  createdAt  DateTime @default(now())
}
